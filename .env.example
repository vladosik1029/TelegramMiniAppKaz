# Скопируй файл в .env и заполни

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF...

# Твой Telegram ID (числовой). Получить: напиши боту @userinfobot
# Можно несколько через запятую: 111111111,222222222
ADMIN_IDS=111111111

# Стартовый баланс новым игрокам (фишки)
START_BALANCE=1000

# URL MiniApp (должен работать по HTTPS в продакшене)
# Для локального теста через ngrok: https://xxxx.ngrok-free.app
WEBAPP_URL=https://example.com

# 1 = режим разработки: работает в обычном браузере без Telegram,
# тестовый пользователь задаётся DEV_USER_ID (сделай его админом через ADMIN_IDS)
DEV_MODE=1
DEV_USER_ID=900001

# Порт API-сервера
PORT=3000
