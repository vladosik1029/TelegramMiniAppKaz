# Скопируй файл в .env и заполни

# Токен бота от @BotFather
BOT_TOKEN=123456789:AAF...

# Твой Telegram ID (числовой). Получить: напиши боту @userinfobot
# Можно несколько через запятую: 111111111,222222222
ADMIN_IDS=111111111

# Стартовый баланс новым игрокам (фишки)
START_BALANCE=1000

# URL MiniApp (в проде: https-домен за Caddy, напр. https://poker.izzinet.xyz;
# локальный dev не требует URL)
WEBAPP_URL=https://poker.izzinet.xyz

# 1 = режим разработки: работает в обычном браузере без Telegram,
# тестовый пользователь задаётся DEV_USER_ID (сделай его админом через ADMIN_IDS)
DEV_MODE=1
DEV_USER_ID=900001

# username бота без @ — для ссылок-приглашений за стол (t.me/<bot>?startapp=room_<id>)
BOT_USERNAME=izzi21_bot

# Порт API-сервера
PORT=3000
